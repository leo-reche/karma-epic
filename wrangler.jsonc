{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karma-epic",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "base_path": "/placeholder-path" },
  "routes": [{ "pattern": "leoreche.com/placeholder-path*", "zone_name": "leoreche.com" }]
}
